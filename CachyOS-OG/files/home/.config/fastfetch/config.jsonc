// ~/.config/fastfetch/config.jsonc
// Icons are Nerd Font glyphs written as \u escapes so they survive copy/paste.
// Generated by Claude Opus 5.5, modified
//
// Missing values:
//   - DE and Battery are "command" modules that print "None" when there is
//     nothing to show (niri is a WM, not a DE; desktops have no battery).
//   - Every other module shows its error message instead of disappearing
//     (display.showErrors), so a line is never silently skipped.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "position": "left"
  },
  "display": {
    "separator": "  ",
  },
  "modules": [
    // ── System ───────────────────────────────
    { "type": "title", "color": { "user": "green", "at": "white", "host": "green" } },
    { "type": "os",         "key": "├  OS",         "keyColor": "green" },
    { "type": "kernel",     "key": "├  Kernel",     "keyColor": "green" },
    { "type": "bootmgr",    "key": "├  Bootmgr",    "keyColor": "green" },
    { "type": "initsystem", "key": "├  Initsystem", "keyColor": "green" },
    { "type": "packages",   "key": "├  Packages",   "keyColor": "green" },
    { "type": "uptime",     "key": "└  Uptime",     "keyColor": "green" },
    "break",

    // ── Desktop ──────────────────────────────
    {
      "type": "command",
      "key": " DE",
      "keyColor": "magenta",
      "text": "if [ -n \"$KDE_FULL_SESSION$GNOME_DESKTOP_SESSION_ID\" ]; then echo \"${XDG_CURRENT_DESKTOP:-None}\"; else echo None; fi"
    },
    { "type": "wm",       "key": "├  WM",       "keyColor": "magenta" },
    { "type": "lm",       "key": "├  LM",       "keyColor": "magenta" },
    { "type": "terminal", "key": "├  Terminal", "keyColor": "magenta" },
    { "type": "shell",    "key": "├  Shell",    "keyColor": "magenta" },
    { "type": "font",     "key": "└  Font",     "keyColor": "magenta" },
    "break",

    // ── Hardware ─────────────────────────────
    { "type": "host",    "key": " Host",       "keyColor": "blue" },
    { "type": "display", "key": "├  Display",  "keyColor": "blue" },
    { "type": "cpu",     "key": "├  CPU",      "keyColor": "blue" },
    { "type": "gpu",     "key": "├  GPU",      "keyColor": "blue" },
    { "type": "memory",  "key": "├  Memory",   "keyColor": "blue" },
    { "type": "swap",    "key": "├  Swap",     "keyColor": "blue" },
    { "type": "disk",    "key": "├  Disk",     "keyColor": "blue" },
    { "type": "battery", "key": "├  Battery",  "keyColor": "blue" },
    { "type": "localip", "key": "└  Local IP", "keyColor": "blue" }
  ]
}
