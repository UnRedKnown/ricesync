// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "markdown_preview": {
    "font_family": "Maple Mono"
  },
  "ui_font_family": "Maple Mono",
  "buffer_font_family": "Maple Mono",
  "session": {
    "trust_all_worktrees": true
  },
  "icon_theme": "Zed (Default)",
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Noctalia Dark Transparent",
  },

  "title_bar": { "show_menus": true },
  "project_panel": { "dock": "left", "starts_open": true },
  "use_system_path_prompts": true,
  "default_open_behavior": "existing_window",
  "cli_default_open_behavior": "existing_window",
  "session": { "restore_unsaved_buffers": false },

  // "theme": "Noctalia Dark Transparent"

  "auto_install_extensions": {
      // your own setup
      "html": true, "toml": true, "lua": true, "fish": true, "kdl": true,
      "ini": true, "desktop": true, "xml": true, "csv": true, "env": true,
      "ssh-config": true, "git-firefly": true, "qml": true, "log": true,
      "editorconfig": true, "make": true, "sql": true, "dockerfile": true,
      // other common ones
      "nix": true, "scss": true, "php": true, "java": true, "kotlin": true,
      "ruby": true, "zig": true, "latex": true, "typst": true, "nginx": true,
      "just": true, "meson": true, "glsl": true, "csharp": true, "powershell": true
  },
  "file_types": {
      "INI": ["mimeapps.list", "*.conf"],
      "Shell Script": ["PKGBUILD", "*.install", ".bashrc", ".profile"]
  }
}
