#!/usr/bin/env python3
"""yazi-filemanager1 - answer "show this file in its folder" requests with yazi

Firefox ("show in folder" in the downloads list) and many other apps don't
open folders through the default app for folders. They ask whichever program
owns the D-Bus name org.freedesktop.FileManager1 (nemo, nautilus, dolphin,
...). This takes that name and opens yazi instead, with the file selected.

D-Bus starts it on demand from
  ~/.local/share/dbus-1/services/org.freedesktop.FileManager1.service
and it quits again after a minute of no requests.

Override the terminal command with YAZI_FM_TERM (words split on spaces).
"""
import os
import shlex
import subprocess
import sys
from urllib.parse import unquote, urlparse

import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

NAME = "org.freedesktop.FileManager1"
PATH = "/org/freedesktop/FileManager1"
IDLE_SECONDS = 60
TERM = shlex.split(os.environ.get(
    "YAZI_FM_TERM", "kitty --class yazi -o confirm_os_window_close=0"))

XML = """
<node>
  <interface name="org.freedesktop.FileManager1">
    <method name="ShowFolders">
      <arg type="as" name="URIs" direction="in"/>
      <arg type="s" name="StartupId" direction="in"/>
    </method>
    <method name="ShowItems">
      <arg type="as" name="URIs" direction="in"/>
      <arg type="s" name="StartupId" direction="in"/>
    </method>
    <method name="ShowItemProperties">
      <arg type="as" name="URIs" direction="in"/>
      <arg type="s" name="StartupId" direction="in"/>
    </method>
  </interface>
</node>
"""

loop = GLib.MainLoop()
idle_source = 0


def to_path(uri):
    if uri.startswith("/"):
        return uri
    u = urlparse(uri)
    return unquote(u.path) if u.scheme == "file" else None


def open_yazi(target):
    # yazi opened on a file starts in its folder with that file selected
    env = dict(os.environ)
    env.pop("DESKTOP_STARTUP_ID", None)
    subprocess.Popen(TERM + ["-e", "yazi", "--", target], env=env,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True,
                     cwd=os.path.expanduser("~"))


def reset_idle():
    global idle_source
    if idle_source:
        GLib.source_remove(idle_source)
    idle_source = GLib.timeout_add_seconds(IDLE_SECONDS, lambda: loop.quit() or False)


def on_call(conn, sender, path, iface, method, params, invocation):
    uris = params.unpack()[0]
    for uri in uris:
        p = to_path(uri)
        if not p:
            continue
        if method == "ShowFolders" and not os.path.isdir(p):
            p = os.path.dirname(p)
        if not os.path.exists(p):
            p = os.path.dirname(p)
            if not os.path.isdir(p):
                continue
        try:
            open_yazi(p)
        except OSError as e:
            print(f"yazi-filemanager1: couldn't start {TERM[0]}: {e}", file=sys.stderr)
        # Several items are almost always in one folder: one window is enough
        break
    invocation.return_value(None)
    reset_idle()


def on_bus(conn, name):
    node = Gio.DBusNodeInfo.new_for_xml(XML)
    conn.register_object(PATH, node.interfaces[0], on_call, None, None)


def on_lost(conn, name):
    print(f"yazi-filemanager1: couldn't take {NAME} (another file manager has it)",
          file=sys.stderr)
    loop.quit()


Gio.bus_own_name(Gio.BusType.SESSION, NAME,
                 Gio.BusNameOwnerFlags.ALLOW_REPLACEMENT | Gio.BusNameOwnerFlags.REPLACE,
                 on_bus, None, on_lost)
reset_idle()
loop.run()
