#!/usr/bin/env bash
# palette-view - show every "name": "#rrggbb" color in a file as a swatch + RGB
#   palette-view FILE      (any JSON/TOML/text containing name/hex pairs)
#   ... | palette-view     (or read from a pipe)
grep -oE '"?[A-Za-z0-9_]+"?[[:space:]]*[:=][[:space:]]*"#[0-9A-Fa-f]{6}"' "${1:-/dev/stdin}" |
while IFS= read -r line; do
    name=${line%%[:=]*}; name=${name//[\" ]/}
    hex=${line##*\"#}; hex=${hex%\"}
    r=$((16#${hex:0:2})); g=$((16#${hex:2:2})); b=$((16#${hex:4:2}))
    printf '\e[48;2;%d;%d;%dm        \e[0m  %-30s #%s  (%3d, %3d, %3d)\n' "$r" "$g" "$b" "$name" "$hex" "$r" "$g" "$b"
done
