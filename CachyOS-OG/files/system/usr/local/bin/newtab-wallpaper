#!/usr/bin/env bash
# newtab-wallpaper - embed an image as Firefox's new-tab background
#
#   newtab-wallpaper [IMAGE]     default IMAGE: ~/.cache/current-wallpaper
#
# Finds the profile Firefox actually uses (from profiles.ini), and only ever
# writes one file: <profile>/chrome/userContent.css. It refuses to run if the
# profile can't be found, and never creates Firefox's own folders.
# The previous userContent.css is kept as userContent.css.bak.
# Your own page CSS goes in <profile>/chrome/userContent-custom.css: the
# generated file imports it, so it survives wallpaper changes.
#
# Firefox reads userContent.css at startup: changes show after a restart.
# Needs: imagemagick, and in about:config
#        toolkit.legacyUserProfileCustomizations.stylesheets = true

set -euo pipefail

die() { echo "newtab-wallpaper: $*" >&2; notify-send -a newtab-wallpaper "Firefox wallpaper not updated" "$*" 2>/dev/null || true; exit 1; }

src=${1:-$HOME/.cache/current-wallpaper}
[[ -r $src ]] || die "image not found: $src"

# --- locate the real profile (read-only) ---------------------------------------
# Firefox uses ~/.mozilla/firefox if it exists, otherwise ~/.config/mozilla/firefox
base=""
for dir in "$HOME/.mozilla/firefox" "${XDG_CONFIG_HOME:-$HOME/.config}/mozilla/firefox"; do
    if [[ -f $dir/profiles.ini ]]; then base=$dir; break; fi
done
[[ -n $base ]] || die "no Firefox profiles.ini found"

# The [Install...] section names the profile Firefox opens by default
rel=$(awk -F= '/^\[Install/ {f=1; next} /^\[/ {f=0} f && $1 == "Default" {print $2; exit}' "$base/profiles.ini")
# Fallback: the [Profile...] section marked Default=1
if [[ -z $rel ]]; then
    rel=$(awk -F= '/^\[Profile/ {p=""; d=0} $1 == "Path" {p=$2} $1 == "Default" && $2 == "1" {d=1} d && p {print p; exit}' "$base/profiles.ini")
fi
[[ -n $rel ]] || die "couldn't find the default profile in $base/profiles.ini"

if [[ $rel == /* ]]; then profile=$rel; else profile=$base/$rel; fi

# Sanity check: a real, used profile has prefs.js and history
[[ -f $profile/prefs.js && -f $profile/places.sqlite ]] \
    || die "$profile doesn't look like a real profile (no prefs.js/places.sqlite), not touching it"

# --- write the CSS (only file this script creates or changes) ------------------
css=$profile/chrome/userContent.css
mkdir -p "$profile/chrome"
[[ -f $css && ! -f $css.bak ]] && cp -- "$css" "$css.bak"

img=$(magick "$src" -resize '2560x1440^' -quality 85 jpg:- | base64 -w0) \
    || die "couldn't convert $src"

tmp=$(mktemp "$profile/chrome/.userContent.XXXXXX")
cat > "$tmp" <<EOF
/* Generated by newtab-wallpaper - edits here are overwritten.
   Put your own CSS in userContent-custom.css next to this file. */
@import url("userContent-custom.css");

@-moz-document url("about:newtab"), url("about:home") {
    html {
        background: url("data:image/jpeg;base64,$img") center / cover no-repeat fixed !important;
    }
    body, .outer-wrapper, main, .non-collapsible-section {
        background: transparent !important;
    }
}
EOF
mv -- "$tmp" "$css"

echo "Updated $css"
